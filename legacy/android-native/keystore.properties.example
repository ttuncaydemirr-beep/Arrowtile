# Bu dosyayı "keystore.properties" adıyla kopyalayın ve kendi değerlerinizi yazın.
# keystore.properties ve .jks dosyası .gitignore'dadır: ASLA paylaşmayın, depoya koymayın, yedeğini güvenli yerde saklayın.
# storeFile yolu android/ klasörüne göredir (ör. ../../anahtarlar/arrowtile-upload.jks ya da tam yol).
storeFile=/TAM/YOL/arrowtile-upload.jks
storePassword=DEPO_SIFRESI
keyAlias=upload
keyPassword=ANAHTAR_SIFRESI
